# The site works in email-draft preview mode until delivery is configured.
APP_ORIGIN=http://localhost:3000
# Configure a verified sender domain in Resend before enabling delivery.
RESEND_API_KEY=
INQUIRY_FROM=
INQUIRY_TO=cintia.cox@compass.com
# Set only behind a trusted proxy that overwrites x-forwarded-for.
TRUST_PROXY=0
# Set 1 only for static design previews (the preview build sets it automatically).
NEXT_PUBLIC_PREVIEW_MODE=0
